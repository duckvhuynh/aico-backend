    "sandboxExecutionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "schema_version",
        "receipt_type",
        "execution_id",
        "logical_idempotency_key",
        "request_digest",
        "scope",
        "outcome",
        "reason",
        "runtime",
        "started_at",
        "completed_at",
        "duration_ms",
        "command_receipts",
        "security_signals",
        "cleanup",
        "receipt_digest"
      ],
      "properties": {
        "contract": { "const": "aico.sandbox-execution-receipt" },
        "schema_version": { "const": "1.0" },
        "receipt_type": { "const": "EXECUTION" },
        "execution_id": { "$ref": "#/$defs/uuid" },
        "logical_idempotency_key": { "$ref": "#/$defs/logicalIdempotencyKey" },
        "request_digest": { "$ref": "#/$defs/sha256" },
        "scope": { "$ref": "#/$defs/executionScope" },
        "outcome": {
          "enum": ["SUCCEEDED", "FAILED", "CANCELED", "UNKNOWN"]
        },
        "reason": {
          "enum": [
            "ALL_COMMANDS_SUCCEEDED",
            "COMMAND_FAILED",
            "COMMAND_TIMED_OUT",
            "EXECUTION_CANCELED",
            "SECURITY_POLICY_VIOLATION",
            "OUTPUT_INTEGRITY_FAILED",
            "RESOURCE_LIMIT_EXCEEDED",
            "RUNTIME_UNAVAILABLE",
            "DEPENDENCY_BUNDLE_UNAVAILABLE",
            "UNKNOWN_EXTERNAL_OUTCOME",
            "CLEANUP_FAILED"
          ]
        },
        "runtime": { "$ref": "#/$defs/runtimeAttestation" },
        "started_at": { "$ref": "#/$defs/rfc3339Utc" },
        "completed_at": { "$ref": "#/$defs/rfc3339Utc" },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 900000
        },
        "command_receipts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/commandReceipt" }
        },
        "security_signals": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/securitySignal" }
        },
        "output_manifest": { "$ref": "#/$defs/outputManifest" },
        "cleanup": { "$ref": "#/$defs/cleanupReceipt" },
        "receipt_digest": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "outcome": { "const": "SUCCEEDED" } },
            "required": ["outcome"]
          },
          "then": {
            "required": ["output_manifest"],
            "properties": {
              "reason": { "const": "ALL_COMMANDS_SUCCEEDED" },
              "output_manifest": { "$ref": "#/$defs/outputManifest" },
              "command_receipts": {
                "type": "array",
                "minItems": 5,
                "maxItems": 5,
                "items": { "$ref": "#/$defs/commandReceipt" }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "outcome": { "const": "UNKNOWN" } },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "reason": { "const": "UNKNOWN_EXTERNAL_OUTCOME" }
            }
          }
        }
      ]
    },
    "terminationReason": {
      "enum": [
        "CANCELLATION_REQUESTED",
        "LEASE_LOST",
        "DEADLINE_EXCEEDED",
        "SECURITY_SIGNAL",
        "OPERATOR_KILL",
        "RUN_TERMINAL"
      ]
    },
