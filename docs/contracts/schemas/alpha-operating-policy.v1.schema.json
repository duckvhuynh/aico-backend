{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicompanyos.dev/schemas/alpha-operating-policy.v1.schema.json",
  "title": "AI Company OS alpha operating policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "status",
    "authority",
    "owners",
    "review_by",
    "qualification",
    "attachments",
    "qa",
    "budgets",
    "capacity",
    "stop_policy",
    "reason_codes",
    "downstream_owners",
    "acceptance"
  ],
  "properties": {
    "$schema": { "const": "../contracts/schemas/alpha-operating-policy.v1.schema.json" },
    "schema_version": { "const": "aico.alpha-operating-policy/1.0" },
    "policy_id": { "const": "alpha-operating-policy" },
    "policy_version": { "const": "1.0.0" },
    "status": { "enum": ["CANDIDATE", "ACCEPTED", "SUPERSEDED"] },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_issue", "product_repository", "product_commit", "requirements"],
      "properties": {
        "parent_issue": { "const": "duckvhuynh/aicompanyos#8" },
        "product_repository": { "const": "duckvhuynh/aicompanyos" },
        "product_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        }
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "design", "qa", "security", "delivery"],
      "properties": {
        "product": { "$ref": "#/$defs/owner" },
        "design": { "$ref": "#/$defs/owner" },
        "qa": { "$ref": "#/$defs/owner" },
        "security": { "$ref": "#/$defs/owner" },
        "delivery": { "$ref": "#/$defs/owner" }
      }
    },
    "review_by": { "type": "string", "format": "date" },
    "qualification": { "$ref": "#/$defs/policySection" },
    "attachments": { "$ref": "#/$defs/policySection" },
    "qa": { "$ref": "#/$defs/policySection" },
    "budgets": { "$ref": "#/$defs/policySection" },
    "capacity": { "$ref": "#/$defs/policySection" },
    "stop_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_effect_exhaustion",
        "in_flight_exhaustion",
        "unknown_outcome",
        "unenforceable_limit",
        "founder_state",
        "prohibited_success_claim"
      ],
      "properties": {
        "pre_effect_exhaustion": { "const": "DENY_BEFORE_RESERVATION_OR_DISPATCH" },
        "in_flight_exhaustion": { "const": "CANCEL_ELIGIBLE_WORK_AND_FENCE_LATE_RESULTS" },
        "unknown_outcome": { "const": "BLOCK_FOR_RECONCILIATION_NO_AUTO_REPLAY" },
        "unenforceable_limit": { "const": "FAIL_CLOSED_CONFIGURATION" },
        "founder_state": { "const": "PERSIST_BLOCKED_WITH_REASON_AND_SAFE_NEXT_ACTION" },
        "prohibited_success_claim": { "const": "NO_SUCCESS_WITHOUT_COMMITTED_EVIDENCE" }
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reason" }
    },
    "downstream_owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^AICO-[0-9]{3}$" }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "candidate_sha",
        "hosted_run_url",
        "accepted_by",
        "accepted_at",
        "evidence_url"
      ],
      "properties": {
        "decision": { "enum": ["PENDING", "ACCEPTED", "REQUEST_CHANGES"] },
        "candidate_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "hosted_run_url": { "type": ["string", "null"], "format": "uri" },
        "accepted_by": { "type": ["string", "null"], "maxLength": 120 },
        "accepted_at": { "type": ["string", "null"], "format": "date" },
        "evidence_url": { "type": ["string", "null"], "format": "uri" }
      }
    }
  },
  "$defs": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "github_login"],
      "properties": {
        "role": { "type": "string", "minLength": 2, "maxLength": 80 },
        "github_login": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,39}$" }
      }
    },
    "policySection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/policyEntry" }
        }
      }
    },
    "policyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "configuration_key",
        "value",
        "unit",
        "owner_roles",
        "rationale",
        "reason_code",
        "review_by"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^A8V-[A-Z0-9-]{3,48}$" },
        "configuration_key": {
          "type": "string",
          "pattern": "^alpha\\.v1\\.[a-z0-9]+(?:[._][a-z0-9]+)*$",
          "maxLength": 120
        },
        "value": { "type": ["string", "number", "boolean", "array", "object"] },
        "unit": {
          "enum": [
            "boolean",
            "count",
            "enum",
            "enum_set",
            "bytes",
            "pixels",
            "pages",
            "tokens",
            "micros_usd",
            "seconds",
            "cpu_cores",
            "cpu_seconds",
            "processes",
            "viewport_pixels",
            "factor"
          ]
        },
        "owner_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["Product", "Design", "Engineering", "QA", "Security", "Delivery"] }
        },
        "rationale": { "type": "string", "minLength": 30, "maxLength": 500 },
        "reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "review_by": { "type": "string", "format": "date" }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "founder_message", "next_action"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "founder_message": { "type": "string", "minLength": 12, "maxLength": 240 },
        "next_action": { "type": "string", "minLength": 12, "maxLength": 240 }
      }
    }
  }
}
