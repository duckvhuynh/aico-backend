  "design_definition_of_ready": {
    "authority_path": "docs/architecture/artifacts/aico-004/template-v1/design-contract.json",
    "authority_digest": "sha256:318e920a75b0470f3f5ab31a9e4c2fc387b78868fb02ba0e3795be624bcc2510",
    "definitions": {
      "route": "An addressable top-level prototype view selected by one stable hash path.",
      "screen": "The single visible route canvas. Template v1 maps one screen to one route.",
      "state": "A non-addressable presentation variant inside a screen; it does not increase the route or screen count."
    },
    "limits": {
      "maximum_routes": 5,
      "maximum_screens": 5,
      "primary_flows": 1,
      "client_only": true,
      "data_mode": "TYPED_LOCAL_FIXTURES_ONLY"
    },
    "route_inventory": [
      ["start", "/start", "start-screen", 1, "Introduce the prototype and its limitation warning."],
      ["input", "/input", "input-screen", 2, "Capture one local-only choice."],
      ["options", "/options", "options-screen", 3, "Compare typed fixture options."],
      ["summary", "/summary", "summary-screen", 4, "Review the local prototype selection."],
      [
        "complete",
        "/complete",
        "complete-screen",
        5,
        "Show the non-production end state and restart action."
      ]
    ],
    "route_inventory_tuple": ["id", "path", "screen_id", "primary_flow_order", "purpose"],
    "ordered_primary_flow": ["start", "input", "options", "summary", "complete"],
    "responsive": {
      "breakpoints": [
        ["compact", 0, 767],
        ["wide", 768, null]
      ],
      "breakpoint_tuple": ["id", "minimum_width_px", "maximum_width_px"],
      "compact_navigation": "Horizontally scrollable labeled progress list; one-column content and full-width actions.",
      "wide_navigation": "Labeled progress list above a centered content card; actions remain keyboard ordered.",
      "maximum_content_width_px": 960,
      "minimum_target_size_px": 44
    },
    "tokens": {
      "spacing_px": [4, 8, 12, 16, 24, 32, 48],
      "color_roles": [
        "canvas",
        "surface",
        "text",
        "muted",
        "accent",
        "accentContrast",
        "border",
        "danger",
        "warningSurface"
      ],
      "type_roles": ["body", "label", "title", "display"],
      "radius_roles": ["control", "card", "pill"],
      "motion": "Respect prefers-reduced-motion; no interaction depends on animation."
    },
    "state_contract": [
      ["LOADING", "Announce progress with role=status; never hide navigation indefinitely."],
      ["EMPTY", "Explain the missing local fixture and offer one recovery action."],
      ["ERROR", "Use role=alert, plain-language local error text, and a retry action."],
      ["SUCCESS", "Render the current screen content and its bounded primary/secondary actions."]
    ],
    "state_contract_tuple": ["state", "interaction"],
    "interactions": {
      "primary": "Continue to the next route in primary-flow order.",
      "secondary": "Return to the previous route without remote persistence.",
      "retry": "Move ERROR directly to deterministic local SUCCESS without network access.",
      "restore": "Move EMPTY directly to deterministic local SUCCESS without network access.",
      "restart": "Clear the in-memory selection and return to /start."
    },
    "accessibility_baseline": {
      "claim": "BASIC_AUTOMATED_SMOKE_ONLY_NO_CONFORMANCE_CLAIM",
      "requirements": [
        "Semantic landmarks and one level-one heading per screen.",
        "Keyboard-operable controls with visible focus.",
        "Programmatic labels and plain-language status/error announcements.",
        "Color is not the only carrier of status.",
        "Reduced-motion preference is respected."
      ]
    },
    "persistent_warning": {
      "text": "Prototype only - not a live production system.",
      "placement": "Persistent banner rendered on every route above primary content.",
      "dismissible": false,
      "scope": "EVERY_ROUTE_AND_STATE"
    }
  },
