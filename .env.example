# Local/test defaults only. Staging/production must set DATABASE_SSL=true and an https
# OBJECT_STORAGE_ENDPOINT. Secret values belong in the ignored .env or a secret manager,
# never in logs or issue evidence. See docs/delivery/AICO_010_ENVIRONMENT_ENCRYPTION.md.
NODE_ENV=development
APP_ENV=local
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://aico:aico@localhost:5432/aico
DATABASE_SSL=false
AUTH_MODE=development
JWT_SECRET=replace-with-at-least-32-characters
JWT_ISSUER=aico-backend
JWT_AUDIENCE=aico-control-plane
WORKER_ID=local-worker-1
WORKER_POLL_INTERVAL_MS=500
WORKER_LEASE_SECONDS=30
MODEL_PROVIDER=deterministic
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=aico-local
OBJECT_STORAGE_ACCESS_KEY=aico
OBJECT_STORAGE_SECRET_KEY=local-minio-secret
OBJECT_STORAGE_FORCE_PATH_STYLE=true
